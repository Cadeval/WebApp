

{% load static %}
{% load get_item %}

<div id="content-container">
    <!-- CSV download form. The Save/Download buttons now live in the footer and
         reference these forms via their "form" attribute; they are only shown
         while the configuration editor is loaded (see htmx-override.js). -->
    <form method="POST" action="{% url 'download_csv' %}" id="download_form" style="display: inline;">
        {% csrf_token %}
    </form>

    <form method="POST" id="config_form" enctype="multipart/form-data" action="{% url 'update_config' %}">
        {% csrf_token %}

        <div class="config-editor-viewport">
        <div class="config-editor-pan">
        <table class="config-editor-table">
            <thead>
            <tr>
                <!-- The first "key" column -->
                <th>Key</th>
                <!-- Then each header -->
                {% for col in headers %}
                    <th>{{ col }}</th>
                {% endfor %}
            </tr>
            </thead>
            <tbody>
            {% for row_key, columns in data_dict.items %}
                <tr>
                    <!-- The first column (row key) is read-only for display -->
                    <td>{{ row_key }}</td>

                    {% for col in headers %}
                        <td>
                            <label>
                                <input
                                        type="text"
                                        name="{{ row_key }}: {{ col }}"
                                        value="{{ columns|get_item:col }}"
                                />
                            </label>
                        </td>
                    {% endfor %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
        </div>
        <br>
    </form>

    {% if plugin_editor_items %}
        <section class="editor-plugins" aria-label="Editor plugins">
            {% for editor_plugin in plugin_editor_items %}
                <article class="editor-plugin-card"
                         data-editor-plugin="{{ editor_plugin.id }}"
                         data-worker-url="{{ editor_plugin.worker_url }}"
                         data-wasm-url="{{ editor_plugin.wasm_url }}"
                         data-artifact-type="{{ editor_plugin.artifact_type }}"
                         data-content-hash="{{ editor_plugin.content_hash }}"
                         data-max-run-ms="{{ editor_plugin.max_run_ms }}">
                    <div class="editor-plugin-card__header">
                        <div>
                            <span class="viewer-eyebrow">Plugin managed UI</span>
                            <h2>{{ editor_plugin.name }}</h2>
                        </div>
                        <span class="editor-plugin-badge" data-plugin-field="generation">Generation 0</span>
                    </div>
                    <p>{{ editor_plugin.description }}</p>
                    <div class="editor-plugin-controls">
                        <label>
                            Value
                            <input type="number" value="21" data-plugin-field="input">
                        </label>
                        <button type="button" class="button fa fa-play" data-plugin-action="run" disabled>
                            Run in worker
                        </button>
                        <button type="button" class="button fa fa-refresh" data-plugin-action="reload">
                            Hot reload
                        </button>
                    </div>
                    <dl class="editor-plugin-output">
                        <div><dt>Status</dt><dd data-plugin-field="status" aria-live="polite">Starting worker…</dd></div>
                        <div><dt>WASM result</dt><dd data-plugin-field="result">—</dd></div>
                    </dl>
                </article>
            {% endfor %}
        </section>
    {% endif %}
</div>
