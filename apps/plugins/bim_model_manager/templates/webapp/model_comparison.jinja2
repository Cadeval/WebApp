{% load static %}
{% load humanize %}
{% load plotly_charts %}
{% load cmp_extras %}
{% load get_item %}

<div id="content-container">

  {% if not available_documents %}
    <div class="muted" role="status" style="text-align:center; padding: 2em 0;">
      No models available to compare yet. Upload and calculate models in your group to see them here.
    </div>
  {% else %}

    {# Selector Form #}
    <form method="get"
          action="{% url 'model_comparison' %}"
          hx-get="{% url 'model_comparison' %}"
          hx-target="#content-container"
          hx-swap="outerHTML"
          style="margin-bottom: 2em; background: #f9f9f9; padding: 1em; border-radius: 8px;">
        <input type="hidden" name="selection" value="1">
        <fieldset style="border: none; padding: 0; margin: 0;">
            <legend style="font-weight: bold; margin-bottom: 0.5em;">Select Models to Compare</legend>
            <div style="display: flex; flex-wrap: wrap; gap: 1em;">
                {% for doc in available_documents %}
                    <label style="display: flex; align-items: center; gap: 0.25em; cursor: pointer; background: white; padding: 0.25em 0.5em; border: 1px solid #ddd; border-radius: 4px;">
                        <input type="checkbox" name="models" value="{{ doc.id }}" {% if doc.id|stringformat:"s" in selected_ids %}checked{% endif %}>
                        {{ doc.description|default:"(untitled model)" }}
                    </label>
                {% endfor %}
            </div>
            <div style="margin-top: 1em;">
                <button type="submit" class="button">Update Comparison</button>
            </div>
        </fieldset>
    </form>

    {% if not data %}
      <div class="muted" role="status" style="text-align:center; padding: 2em 0;">
        Select at least one model to compare.
      </div>
    {% else %}

  {# === Charts Row 1 === #}
  <div class="flexgrid-container" style="align-self:stretch;">
    <div class="flex-graph-active">
      {% plot_bgf_bar data as bgf_bar_html %}
      <div class="plot-container">{{ bgf_bar_html|safe }}</div>
    </div>
    <div class="flex-graph-active">
      {% plot_bgf_bri_scatter data as scatter_html %}
      <div class="plot-container">{{ scatter_html|safe }}</div>
    </div>
  </div>

  {# === Charts Row 2 === #}
  <div class="flexgrid-container" style="align-self:stretch;">
    <div class="flex-graph-active">
      {% plot_material_mass_stacked data as mat_mass_html %}
      <div class="plot-container">{{ mat_mass_html|safe }}</div>
    </div>
    <div class="flex-graph-active">
      {% plot_gwp_grouped data as gwp_html %}
      <div class="plot-container">{{ gwp_html|safe }}</div>
    </div>
  </div>

  {# === Charts Row 3 === #}
  <div class="flexgrid-container" style="align-self:stretch;">
    <div class="flex-graph-active">
      {% plot_circularity_shares data as circularity_html %}
      <div class="plot-container">{{ circularity_html|safe }}</div>
    </div>
  </div>

  <h2 style="text-align:center;">Model Comparison</h2>

  {# ===== SUMMARY CARDS ===== #}
  <div class="flexgrid-container" style="align-self:stretch;">
    {% for doc in data %}
      <div class="flex-item-active">
        <h4 style="margin:.25em 0 0 0;">{{ doc.description|default:"(untitled)" }}</h4>
        <div class="muted">Group: {{ doc.group.name|default:"—" }}</div>
        {% with bm=doc.building_metrics.all|first %}
          {% if bm %}
            <table>
              <tbody>
                <tr><th>BGF</th><td>{{ bm.brutto_grundfläche|floatformat:2 }} {{ bm.brutto_grundfläche_unit }}</td></tr>
                <tr><th>NRF</th><td>{{ bm.netto_raumfläche|floatformat:2 }} {{ bm.netto_raumfläche_unit }}</td></tr>
                <tr><th>BRI</th><td>{{ bm.brutto_rauminhalt|floatformat:2 }} {{ bm.brutto_rauminhalt_unit }}</td></tr>
                <tr><th>BGF/BF</th><td>{{ bm.bgf_bf_ratio|floatformat:3 }}</td></tr>
                <tr><th>BRI/BGF</th><td>{{ bm.bri_bgf_ratio|floatformat:3 }}</td></tr>
                <tr><th>Gross facade</th><td>{{ bm.fassadenflaeche|floatformat:2 }} {{ bm.fassadenflaeche_unit }}</td></tr>
                <tr><th>Facade openings</th><td>{{ bm.fassaden_oeffnungsflaeche|floatformat:2 }} {{ bm.fassaden_oeffnungsflaeche_unit }}</td></tr>
                <tr><th>Opaque facade</th><td>{{ bm.fassaden_opake_flaeche|floatformat:2 }} {{ bm.fassaden_opake_flaeche_unit }}</td></tr>
                <tr><th>Window-to-wall ratio</th><td>{{ bm.fenster_wand_verhaeltnis|ratio_percent|floatformat:2 }}%</td></tr>
                <tr><th>Stockwerke</th><td>{{ bm.stockwerke|floatformat:1 }}</td></tr>
                <tr><th>Energy simulation</th><td>{{ bm.get_energy_status_display }}</td></tr>
                {% if bm.energy_status == "success" %}
                  <tr><th>Annual site energy</th><td>{{ bm.annual_site_energy_kwh|floatformat:2 }} kWh/year</td></tr>
                  <tr><th>Energy use intensity</th><td>{{ bm.energy_use_intensity_kwh_m2_year|floatformat:2 }} kWh/m²/year</td></tr>
                {% endif %}
              </tbody>
            </table>
          {% else %}
            <div class="muted">No BuildingMetrics found.</div>
          {% endif %}
        {% endwith %}
      </div>
    {% endfor %}
  </div>

  {# ===== BUILDING METRICS (rows) with best-value highlighting ===== #}
  <h3 id="comparison-stats-heading">Building Metrics (side-by-side)</h3>

  {# Choose highlight policy (max or min) per metric #}
  {% bm_best_value data "brutto_grundfläche" "max" as best_bgf %}
  {% bm_best_value data "netto_raumfläche" "max" as best_nrf %}
  {% bm_best_value data "brutto_rauminhalt" "max" as best_bri %}
  {% bm_best_value data "bgf_bf_ratio" "max" as best_bgf_bf %}
  {% bm_best_value data "bri_bgf_ratio" "min" as best_bri_bgf %}
  {% bm_best_value data "energy_use_intensity_kwh_m2_year" "min" as best_eui %}

  <table>
    <thead>
      <tr>
        <th>Metric</th>
        {% for doc in data %}
          <th>{{ doc.description|default:"(untitled)" }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      <tr>
        <th>Grundstücksfläche</th>
        {% for doc in data %}
          {% with v=doc|bm_value:"grundstuecksfläche" %}
            <td>{% if v != "" %}{{ v|floatformat:2 }} {{ doc|bm_unit:"grundstuecksfläche" }}{% else %}—{% endif %}</td>
          {% endwith %}
        {% endfor %}
      </tr>
      <tr>
        <th>Bebaute Fläche</th>
        {% for doc in data %}
          {% with v=doc|bm_value:"bebaute_fläche" %}
            <td>{% if v != "" %}{{ v|floatformat:2 }} {{ doc|bm_unit:"bebaute_fläche" }}{% else %}—{% endif %}</td>
          {% endwith %}
        {% endfor %}
      </tr>
      <tr>
        <th>Unbebaute Fläche</th>
        {% for doc in data %}
          {% with v=doc|bm_value:"unbebaute_fläche" %}
            <td>{% if v != "" %}{{ v|floatformat:2 }} {{ doc|bm_unit:"unbebaute_fläche" }}{% else %}—{% endif %}</td>
          {% endwith %}
        {% endfor %}
      </tr>

      {# Highlighted ones #}
      <tr>
        <th>BGF</th>
        {% for doc in data %}
          {% with v=doc|bm_value:"brutto_grundfläche" %}
            <td class="{% if data|length > 1 and v|is_best_value:best_bgf %}best-value{% endif %}">
              {% if v != "" %}{{ v|floatformat:2 }} {{ doc|bm_unit:"brutto_grundfläche" }}{% else %}—{% endif %}
            </td>
          {% endwith %}
        {% endfor %}
      </tr>
      <tr>
        <th>NRF</th>
        {% for doc in data %}
          {% with v=doc|bm_value:"netto_raumfläche" %}
            <td class="{% if data|length > 1 and v|is_best_value:best_nrf %}best-value{% endif %}">
              {% if v != "" %}{{ v|floatformat:2 }} {{ doc|bm_unit:"netto_raumfläche" }}{% else %}—{% endif %}
            </td>
          {% endwith %}
        {% endfor %}
      </tr>
      <tr>
        <th>BRI</th>
        {% for doc in data %}
          {% with v=doc|bm_value:"brutto_rauminhalt" %}
            <td class="{% if data|length > 1 and v|is_best_value:best_bri %}best-value{% endif %}">
              {% if v != "" %}{{ v|floatformat:2 }} {{ doc|bm_unit:"brutto_rauminhalt" }}{% else %}—{% endif %}
            </td>
          {% endwith %}
        {% endfor %}
      </tr>
      <tr>
        <th>BGF/BF ratio</th>
        {% for doc in data %}
          {% with v=doc|bm_value:"bgf_bf_ratio" %}
            <td class="{% if data|length > 1 and v|is_best_value:best_bgf_bf %}best-value{% endif %}">
              {% if v != "" %}{{ v|floatformat:3 }}{% else %}—{% endif %}
            </td>
          {% endwith %}
        {% endfor %}
      </tr>
      <tr>
        <th>BRI/BGF ratio</th>
        {% for doc in data %}
          {% with v=doc|bm_value:"bri_bgf_ratio" %}
            <td class="{% if data|length > 1 and v|is_best_value:best_bri_bgf %}best-value{% endif %}">
              {% if v != "" %}{{ v|floatformat:3 }}{% else %}—{% endif %}
            </td>
          {% endwith %}
        {% endfor %}
      </tr>
      <tr>
        <th>Energy use intensity</th>
        {% for doc in data %}
          {% with v=doc|bm_value:"energy_use_intensity_kwh_m2_year" %}
            <td class="{% if data|length > 1 and v|is_best_value:best_eui %}best-value{% endif %}">
              {% if v != "" %}{{ v|floatformat:2 }} kWh/m²/year{% else %}—{% endif %}
            </td>
          {% endwith %}
        {% endfor %}
      </tr>
    </tbody>
  </table>

  {# ===== MATERIAL TOTALS per model (best highlighted) ===== #}
  {% mats_best_total data "gwp_ml_a1_a3" "min" as best_gwp_a1a3 %}
  {% mats_best_total data "penrt_ml_a1_a3" "min" as best_penrt_a1a3 %}
  {% mats_best_total data "ap_ml_a1_a3" "min" as best_ap_a1a3 %}
  {% mats_best_total data "recyclable_mass" "max" as best_recyclable %}
  {% mats_best_total data "waste_mass" "min" as best_waste %}

  <h3>Material Properties — Totals per Model</h3>
  <table>
    <thead>
      <tr>
        <th>Model</th>
        <th># Materials</th>
        <th>Total Volume</th>
        <th>Total Area</th>
        <th>Total Length</th>
        <th>Total Mass</th>
        <th>Total GWP A1–A3</th>
        <th>Total PEnrT A1–A3</th>
        <th>Total AP A1–A3</th>
        <th>Recyclable Mass</th>
        <th>Waste Mass</th>
      </tr>
    </thead>
    <tbody>
      {% for doc in data %}
        {% mats_total doc "volume" as t_vol %}
        {% mats_total doc "area" as t_area %}
        {% mats_total doc "length" as t_len %}
        {% mats_total doc "mass" as t_mass %}
        {% mats_total doc "gwp_ml_a1_a3" as t_gwp_a1a3 %}
        {% mats_total doc "penrt_ml_a1_a3" as t_penrt_a1a3 %}
        {% mats_total doc "ap_ml_a1_a3" as t_ap_a1a3 %}
        {% mats_total doc "recyclable_mass" as t_recyclable %}
        {% mats_total doc "waste_mass" as t_waste %}
        {% with mats=doc.material_properties.all %}
        <tr>
          <td>{{ doc.description|default:"(untitled)" }}</td>
          <td>{{ mats|length }}</td>
          <td>{{ t_vol|floatformat:2 }}</td>
          <td>{{ t_area|floatformat:2 }}</td>
          <td>{{ t_len|floatformat:2 }}</td>
          <td>{{ t_mass|floatformat:2 }}</td>

          <td class="{% if data|length > 1 and t_gwp_a1a3|is_best_value:best_gwp_a1a3 %}best-value{% endif %}">
            {{ t_gwp_a1a3|floatformat:2 }}
          </td>
          <td class="{% if data|length > 1 and t_penrt_a1a3|is_best_value:best_penrt_a1a3 %}best-value{% endif %}">
            {{ t_penrt_a1a3|floatformat:2 }}
          </td>
          <td class="{% if data|length > 1 and t_ap_a1a3|is_best_value:best_ap_a1a3 %}best-value{% endif %}">
            {{ t_ap_a1a3|floatformat:2 }}
          </td>
          <td class="{% if data|length > 1 and t_recyclable|is_best_value:best_recyclable %}best-value{% endif %}">
            {{ t_recyclable|floatformat:2 }}
          </td>
          <td class="{% if data|length > 1 and t_waste|is_best_value:best_waste %}best-value{% endif %}">
            {{ t_waste|floatformat:2 }}
          </td>
        </tr>
        {% endwith %}
      {% endfor %}
    </tbody>
  </table>

  {# ===== MATERIAL DETAILS ===== #}
  <h3>Material Details</h3>
  <div class="flexgrid-container" style="align-self:stretch;">
    {% for doc in data %}
      <div class="flex-item-active" style="text-align:left;">
        <details {% if forloop.first %}open{% endif %}>
          <summary><b>{{ doc.description|default:"(untitled)" }}</b> — Materials</summary>
          {% with mats=doc.material_properties.all %}
            {% if mats %}
              <table class="narrow">
                <thead>
                  <tr>
                    <th>Material</th>
                    <th>Volume</th>
                    <th>Area</th>
                    <th>Length</th>
                    <th>Mass</th>
                    <th>GWP A1–A3</th>
                    <th>AP A1–A3</th>
                    <th>PEnrT A1–A3</th>
                  </tr>
                </thead>
                <tbody>
                  {% for m in mats %}
                    <tr>
                      <td>{{ m.name }}</td>
                      <td>{{ m.volume|floatformat:2 }}</td>
                      <td>{{ m.area|floatformat:2 }}</td>
                      <td>{{ m.length|floatformat:2 }}</td>
                      <td>{{ m.mass|floatformat:2 }}</td>
                      <td>{{ m.gwp_ml_a1_a3|floatformat:2 }}</td>
                      <td>{{ m.ap_ml_a1_a3|floatformat:2 }}</td>
                      <td>{{ m.penrt_ml_a1_a3|floatformat:2 }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            {% else %}
              <div class="muted">No materials found.</div>
            {% endif %}
          {% endwith %}
        </details>
      </div>
    {% endfor %}
  </div>

  {% endif %}
  {% endif %}
</div>
