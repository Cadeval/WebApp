<div id="epw-library">
    <form method="post"
          enctype="multipart/form-data"
          hx-post="{% url 'upload_epw' %}"
          hx-target="#epw-library"
          hx-swap="outerHTML">
        {% csrf_token %}
        {{ epw_upload_form.as_p }}
        <button type="submit" class="button-wide fa fa-upload">
            Upload EPW file
        </button>
    </form>

    {% if epw_uploads %}
        <ul class="settings-file-list" aria-label="Uploaded EnergyPlus weather files">
            {% for epw in epw_uploads %}
                <li>
                    <span>
                        <strong>{{ epw.description|default:epw.document.name }}</strong>
                        <small>{{ epw.document.name }} · {{ epw.uploaded_at|date:"Y-m-d H:i" }}</small>
                    </span>
                    <form method="post"
                          hx-post="{% url 'delete_epw' pk=epw.id %}"
                          hx-target="#epw-library"
                          hx-swap="outerHTML">
                        {% csrf_token %}
                        <button type="submit"
                                class="button fa fa-trash"
                                aria-label="Delete {{ epw.description|default:epw.document.name }}">
                            Delete
                        </button>
                    </form>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="settings-empty" role="status">
            No weather files uploaded yet. Add an EPW file to enable an OpenStudio energy simulation.
        </p>
    {% endif %}
</div>