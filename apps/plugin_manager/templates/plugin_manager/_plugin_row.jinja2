{% load static %}
<tr id="plugin-row-{{ record.plugin_id }}" class="plugin-row{% if record.has_error %} plugin-row--error{% endif %}">
    <th scope="row" class="plugin-identity">
        <strong>{{ record.name }}</strong>
        <code>{{ record.plugin_id }}</code>
    </th>
    <td>{{ record.version|default:"—" }}</td>
    <td>{{ record.api_version|default:"—" }}</td>
    <td>{{ record.priority }}</td>
    <td aria-live="polite">
        {% if record.enabled %}
            <span class="plugin-status plugin-status--enabled">
                <span class="fa fa-check-circle" aria-hidden="true"></span> Enabled
            </span>
        {% elif record.has_error %}
            <span class="plugin-status plugin-status--error">
                <span class="fa fa-exclamation-circle" aria-hidden="true"></span> Error
            </span>
        {% else %}
            <span class="plugin-status plugin-status--disabled">
                <span class="fa fa-pause-circle" aria-hidden="true"></span> Disabled
            </span>
        {% endif %}
    </td>
    <td class="plugin-error-cell">
        {% if record.has_error %}
            <span title="{{ record.error }}">{{ record.error }}</span>
        {% else %}
            <span aria-hidden="true">—</span>
        {% endif %}
    </td>
    <td class="plugin-actions">
        {% if record.enabled %}
            <button type="button"
                    class="button plugin-action-button fa fa-toggle-off"
                    hx-post="{% url 'plugin_manager:plugin_disable' record.plugin_id %}"
                    hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}'
                    hx-target="closest tr"
                    hx-swap="outerHTML">
                Disable
            </button>
        {% elif not record.has_error %}
            <button type="button"
                    class="button plugin-action-button fa fa-toggle-on"
                    hx-post="{% url 'plugin_manager:plugin_enable' record.plugin_id %}"
                    hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}'
                    hx-target="closest tr"
                    hx-swap="outerHTML">
                Enable
            </button>
        {% else %}
            <span class="plugin-action-unavailable"
                  title="Resolve the error and rediscover this plugin before enabling it.">
                <span class="fa fa-ban" aria-hidden="true"></span>
                Unavailable
            </span>
        {% endif %}
    </td>
</tr>
