{% load static %}
<section {% if fragment %}id="content-container"{% endif %} class="plugin-manager-shell journey-page" aria-labelledby="plugins-title">
    <link rel="stylesheet" href="{% static 'css/plugin_store.css' %}?v=20261003-journey">
    <div class="journey-section-heading"><span class="viewer-eyebrow">Your workspace tools</span><h1 id="plugins-title">Plugins</h1><p>Choose the tools you need. Selected tools appear in your navigation.</p></div>
    {% if notice %}<p class="journey-notice" role="status" aria-live="polite">{{ notice }}</p>{% endif %}
    {% if reload_summary %}<p class="journey-notice" role="status" aria-live="polite">{{ reload_summary }}</p>{% endif %}
    {% if request.method == 'POST' %}{% include 'plugin_manager/_plugin_nav_items.jinja2' with plugin_nav_oob=True %}{% endif %}

    <form method="get" action="{% url 'plugin_manager:plugin_list' %}" hx-get="{% url 'plugin_manager:plugin_list' %}" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="true" class="plugin-store-search"><label for="plugin-search">Find a tool</label><input id="plugin-search" type="search" name="q" value="{{ query }}"><button type="submit">Search</button></form>

    <section aria-labelledby="my-workflow-title">
        <div class="journey-section-heading"><h2 id="my-workflow-title">My workflow</h2><p>Your selected tools. Removing a tool keeps your saved work.</p></div>
        <div class="plugin-store-grid">
            {% for item in selected_catalog %}{% include 'plugin_manager/_workflow_card.html' %}{% empty %}
                <div class="plugin-collection-empty"><h3>{% if query %}No selected tools match{% else %}Choose your first tool{% endif %}</h3><p>{% if query %}Try another search.{% else %}Add a tool from the available options below.{% endif %}</p></div>
            {% endfor %}
        </div>
    </section>
    <section aria-labelledby="available-tools-title">
        <div class="journey-section-heading"><h2 id="available-tools-title">Available tools</h2><p>Add a tool to use it in your workflow.</p></div>
        <div class="plugin-store-grid">
            {% for item in available_catalog %}{% include 'plugin_manager/_workflow_card.html' %}{% empty %}<div class="plugin-collection-empty"><p>{% if query %}No available tools match this search.{% elif selected_catalog %}You have added all currently available tools.{% else %}Tools will appear here when they become available.{% endif %}</p></div>{% endfor %}
        </div>
    </section>

    <details class="journey-card plugin-publishing"{% if upload_form.errors %} open{% endif %}>
        <summary>Publish a signed plugin</summary>
        <p>Contribute a browser tool to the site catalog. New packages are reviewed before becoming available.</p>
        <p class="plugin-publishing-links"><a href="/mycelium/settings?section=security" hx-get="/mycelium/settings?section=security" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="true">Manage signing keys in User settings</a><a href="{% url 'plugin_manager:plugin_sample' %}" hx-boost="false">Download an example package</a></p>
        <form class="plugin-upload-form" data-task-label="Uploading and checking plugin package" method="post" action="{% url 'plugin_manager:plugin_upload' %}" enctype="multipart/form-data" hx-post="{% url 'plugin_manager:plugin_upload' %}" hx-encoding="multipart/form-data" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="false">
            {% csrf_token %}<input type="hidden" name="return_to" value="manager">{{ upload_form.non_field_errors }}
            <div class="plugin-upload-grid">{% for field in upload_form %}<div class="plugin-form-field{% if field.errors %} plugin-form-field--error{% endif %}"><label for="{{ field.id_for_label }}">{{ field.label }}</label>{{ field }}{% for error in field.errors %}<span class="plugin-field-error" role="alert">{{ error }}</span>{% endfor %}</div>{% endfor %}</div>
            <div class="plugin-upload-footer"><p class="plugin-help-text">Sign your archive locally with the CLI. Accepted: ZIP, TAR, tar.gz/tgz and tar.xz/txz. The manifest supplies the plugin name, ID and version.</p><button class="button" type="submit" hx-disable="this">Publish plugin</button></div>
        </form>
    </details>

    {% if user.is_staff %}
        <details class="journey-card plugin-administration"{% if reload_summary %} open{% endif %}>
            <summary>Site plugin administration</summary><p>Global controls determine which plugins are available to the site. These settings are separate from your personal workflow.</p>
            <button type="button" class="button" data-task-label="Refreshing plugin discovery" hx-post="{% url 'plugin_manager:plugin_reload' %}" hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}' hx-target="#content-container" hx-swap="outerHTML" hx-disable="this">Refresh plugin discovery</button>
            <div class="plugin-table-viewport" tabindex="0" aria-label="Site plugin inventory"><table id="plugin-table" class="plugin-table"><thead><tr><th scope="col">Plugin</th><th scope="col">Version</th><th scope="col">API</th><th scope="col">Priority</th><th scope="col">Site status</th><th scope="col">Error</th><th scope="col">Actions</th></tr></thead><tbody id="plugin-table-body">{% for item in catalog %}{% include 'plugin_manager/_plugin_row.jinja2' with record=item.record selected=item.selected available=item.available is_workflow=item.is_workflow description=item.description %}{% empty %}<tr><td colspan="7">No matching plugins.</td></tr>{% endfor %}</tbody></table></div>
        </details>
    {% endif %}
</section>
