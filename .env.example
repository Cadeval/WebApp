# Settings read the process environment. This file is a reference, not an
# automatically loaded dotenv file. Never commit populated credentials.
# Development uses make debug; SQLite is the default database.
# Production (make run) requires a random key of at least 50 characters.
# Generate a key: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Optional production database/cache; install their Python drivers separately:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# REDIS_URL=redis://HOST:6379/0
IFC_GEOMETRY_THREADS=4
IFC_PARALLEL_VALIDATION=true
IFC_PARALLEL_VALIDATION_MIN_BYTES=2000000
# Optional CLI used by the independent OpenStudio simulation utilities:
# OPENSTUDIO_CLI_PATH=/path/to/openstudio
OPENSTUDIO_TIMEOUT_SECONDS=900
