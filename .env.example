# Copy this file to `.env` (already git-ignored) and fill in real values before
# running `docker compose up`. Never commit the resulting `.env` file.

# PostgreSQL / Django database password. Must match between the "cadevil" and
# "postgresql" services - docker-compose.yml injects it into both.
DB_PASSWORD=change-me-to-a-long-random-value

# Redis password shared by the Channels layer and the Django cache. Keep this
# alphanumeric (no @, :, /, %, # etc.) since it is embedded directly into a
# redis:// connection URL in settings.py - special URL characters would break
# that URL rather than being treated as literal password characters.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32).replace('-', '').replace('_', ''))"
REDIS_PASSWORD=change-me-to-a-long-random-value

# Django SECRET_KEY used for session/CSRF signing, password reset tokens, etc.
# Generate one with:
#   python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#%^&*(-_=+)') for _ in range(50)))"
SECRET_KEY=change-me-to-a-long-random-value
