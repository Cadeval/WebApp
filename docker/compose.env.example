# Public deployment metadata and secret FILE PATHS only. Keep actual keys and
# passwords outside this checkout; pass a reviewed copy via --env-file.
COMPOSE_PROJECT_NAME=cadevil
CADEVIL_IMAGE=cadevil:0.14.1
CADEVIL_ALLOWED_HOSTS=cadevil.example.org
CADEVIL_CSRF_TRUSTED_ORIGINS=https://cadevil.example.org
CADEVIL_SWAG_NETWORK=swagnet
CADEVIL_PRIVATE_INTERNAL=true
CADEVIL_DJANGO_SECRET_FILE=/secure/cadevil/secrets/django_secret_key
CADEVIL_POSTGRES_PASSWORD_FILE=/secure/cadevil/secrets/postgres_password
CADEVIL_POSTGRES_ADMIN_PASSWORD_FILE=/secure/cadevil/secrets/postgres_admin_password
CADEVIL_REDIS_PASSWORD_FILE=/secure/cadevil/secrets/redis_password
CADEVIL_DB_USER=cadevil
CADEVIL_DB_NAME=cadevil
CADEVIL_HTTP_PROCESSES=2
IFC_GEOMETRY_THREADS=2
CADEVIL_APP_MEMORY=2g
CADEVIL_APP_CPUS=2
CADEVIL_REDIS_MAXMEMORY=256mb
