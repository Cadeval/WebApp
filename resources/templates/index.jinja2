<div {% if fragment %}id="content-container"{% endif %} class="journey-page home-page">
    <section class="journey-hero" aria-labelledby="home-title">
        <span class="viewer-eyebrow">Building assessment</span>
        <h1 id="home-title">Explore your building models</h1>
        <p>Cadevil connects IFC geometry with material quantities, environmental impacts and recovery costs.</p>
        <div class="journey-actions">
            {% if user.is_authenticated %}
                <a class="journey-button" href="/plugins/manage/" hx-get="/plugins/manage/" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="true">Choose workflow tools</a>
                <a href="/mycelium/settings" hx-get="/mycelium/settings" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="true">User settings</a>
            {% else %}
                <a class="journey-button" href="/mycelium/login" hx-get="/mycelium/login" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="true">Log in to your workspace</a>
            {% endif %}
            <a href="/demo" hx-get="/demo" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="true">Open demo</a>
        </div>
    </section>

    {% if user.is_authenticated %}
        <section aria-labelledby="home-workflow-title">
            <div class="journey-section-heading"><h2 id="home-workflow-title">Your workflow</h2><p>Open a chosen tool or add another from Plugins.</p></div>
            <div class="journey-grid">
                {% for item in plugin_nav_items|slice:':3' %}
                    <a class="journey-card journey-card-link" href="{{ item.url }}" {% if item.full_page %}hx-boost="false"{% else %}hx-get="{{ item.url }}" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="true"{% endif %}><span class="fa {{ item.icon }}" aria-hidden="true"></span><h3>{{ item.label }}</h3><span>Open tool</span></a>
                {% empty %}
                    <div class="journey-card"><h3>Start with the tools you need</h3><p>Choose available plugins for your workflow. Your selection stays with your account.</p><a href="/plugins/manage/" hx-get="/plugins/manage/" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="true">Browse available tools</a></div>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    <section class="journey-card home-demo" aria-labelledby="home-demo-title">
        <span class="viewer-eyebrow">Try a walkthrough</span><h2 id="home-demo-title">See the models and calculations</h2>
        <p>Explore the A–D house geometry and a recorded calculation walkthrough. The demo includes provisional material, environmental and cost estimates.</p>
        <a class="journey-button" href="/demo" hx-get="/demo" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="true">Open demo</a>
    </section>
</div>
