<section id="energy-performance"
         class="model-detail__card"
         aria-labelledby="energy-performance-heading">
    <h3 id="energy-performance-heading">Energy performance</h3>
    <form method="post"
          action="{% url 'cadevil_document-calculate_energy' pk=data.id %}"
          hx-post="{% url 'cadevil_document-calculate_energy' pk=data.id %}"
          hx-target="#energy-performance"
          hx-swap="outerHTML"
          class="energy-form">
        {% csrf_token %}
        <div class="form-group">
            <label for="energy-weather-file">Weather file (EPW)</label>
            <select name="epw_file_id"
                    id="energy-weather-file"
                    required
                    {% if not epw_files %}disabled aria-describedby="energy-weather-help"{% endif %}>
                {% if epw_files %}
                    <option value="">Select a weather file</option>
                    {% for epw in epw_files %}
                        <option value="{{ epw.id }}"
                                {% if building_metrics.energy_weather_upload_id == epw.id %}selected{% endif %}>
                            {{ epw.description|default:epw.document.name }}
                        </option>
                    {% endfor %}
                {% else %}
                    <option value="">No weather files available</option>
                {% endif %}
            </select>
        </div>
        <button type="submit" class="button fa fa-bolt" {% if not epw_files %}disabled{% endif %}>
            Run energy simulation
        </button>
        {% if not epw_files %}
            <p id="energy-weather-help" class="help-text">
                Upload an EPW file in your weather file library first.
            </p>
        {% endif %}
    </form>

    {% if building_metrics %}
        <dl class="model-detail__properties energy-results">
            <dt>Energy rating</dt>
            <dd>{{ building_metrics.energie_bewertung|default:"Unavailable" }}</dd>
            <dt>Simulation status</dt>
            <dd>{{ building_metrics.get_energy_status_display|default:"Unavailable" }}</dd>
            <dt>Annual site energy</dt>
            <dd>
                {% if building_metrics.annual_site_energy_kwh != None %}
                    {{ building_metrics.annual_site_energy_kwh|floatformat:2 }} kWh/year
                {% else %}Unavailable{% endif %}
            </dd>
            <dt>Annual electricity</dt>
            <dd>
                {% if building_metrics.annual_electricity_kwh != None %}
                    {{ building_metrics.annual_electricity_kwh|floatformat:2 }} kWh/year
                {% else %}Unavailable{% endif %}
            </dd>
            <dt>Annual natural gas</dt>
            <dd>
                {% if building_metrics.annual_natural_gas_kwh != None %}
                    {{ building_metrics.annual_natural_gas_kwh|floatformat:2 }} kWh/year
                {% else %}Unavailable{% endif %}
            </dd>
            <dt>Energy use intensity (EUI)</dt>
            <dd>
                {% if building_metrics.energy_use_intensity_kwh_m2_year != None %}
                    {{ building_metrics.energy_use_intensity_kwh_m2_year|floatformat:2 }} kWh/m²/year
                {% else %}Unavailable{% endif %}
            </dd>
            <dt>Weather library entry</dt>
            <dd>{{ building_metrics.energy_weather_upload|default:"Unavailable" }}</dd>
            <dt>Weather file used</dt>
            <dd>{{ building_metrics.energy_weather_file|default:"Unavailable" }}</dd>
            <dt>OpenStudio/EnergyPlus version</dt>
            <dd>{{ building_metrics.openstudio_version|default:"Unavailable" }}</dd>
            <dt>Simulated at</dt>
            <dd>{{ building_metrics.energy_simulated_at|date:"Y-m-d H:i"|default:"Unavailable" }}</dd>
            <dt>Assumptions</dt>
            <dd class="model-detail__long-value">
                {{ building_metrics.energy_assumptions|default:"Unavailable" }}
            </dd>
            <dt>Error detail</dt>
            <dd class="model-detail__long-value{% if building_metrics.energy_error %} error-text{% endif %}">
                {{ building_metrics.energy_error|default:"Unavailable" }}
            </dd>
        </dl>
    {% else %}
        <p class="model-detail__empty" role="status">
            Building metrics are not available. You can still run the energy simulation.
        </p>
    {% endif %}
</section>