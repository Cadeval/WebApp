{% load static %}
{% load get_item %}
{% load render_svg %}
{% load concat %}
{% load cmp_extras %}

<div id="content-container" class="model-detail">
    <header class="model-detail__header">
        <p class="settings-eyebrow">Model properties</p>
        <h2>{{ data.description|default:"Model detail" }}</h2>
    </header>

    <div class="model-detail__grid">

        <section class="model-detail__card">
            <h3>Model overview</h3>
            <img alt="Render of {{ data.description }}" class="thumbnail-large" src="{% static 'images' %}/house_1.png">
            <dl class="model-detail__properties">
                <dt>ID</dt>
                <dd>{{ data.id }}</dd>
                <dt>Description</dt>
                <dd>{{ data.description|default:"Unavailable" }}</dd>
                <dt>Source description</dt>
                <dd>{{ data.upload.description|default:"Unavailable" }}</dd>
                <dt>Owner</dt>
                <dd>{{ data.user.username }}</dd>
                <dt>Group</dt>
                <dd>{{ data.group.name|default:"None" }}</dd>
                <dt>Source file</dt>
                <dd>{{ data.upload.document.name|basename|default:"Unavailable" }}</dd>
                <dt>Uploaded at</dt>
                <dd>{{ data.upload.uploaded_at|date:"Y-m-d H:i"|default:"Unavailable" }}</dd>
                <dt>Status</dt>
                <dd>{% if data.is_active %}Active{% else %}Inactive{% endif %}</dd>
                <dt>Project type</dt>
                <dd>{{ data.type }}</dd>
                <dt>Structure</dt>
                <dd>{{ data.structure }}</dd>
            </dl>
        </section>

        <section class="model-detail__card">
            <h3>Spatial metrics</h3>
            {% if building_metrics %}
            <dl class="model-detail__properties">
                <dt>Metrics ID</dt>
                <dd>{{ building_metrics.id }}</dd>
                <dt>Stories</dt>
                <dd>{{ building_metrics.stockwerke|floatformat:0 }}</dd>
                <dt>Property area (GF)</dt>
                <dd>{{ building_metrics.grundstuecksfläche|floatformat:2 }} {{ building_metrics.grundstuecksfläche_unit }}</dd>
                <dt>Built-up area (BF)</dt>
                <dd>{{ building_metrics.bebaute_fläche|floatformat:2 }} {{ building_metrics.bebaute_fläche_unit }}</dd>
                <dt>Unbuilt area (UF)</dt>
                <dd>{{ building_metrics.unbebaute_fläche|floatformat:2 }} {{ building_metrics.unbebaute_fläche_unit }}</dd>
                <dt>Gross floor area (BGF)</dt>
                <dd>{{ building_metrics.brutto_grundfläche|floatformat:2 }} {{ building_metrics.brutto_grundfläche_unit }}</dd>
                <dt>Construction area (KGF)</dt>
                <dd>{{ building_metrics.konstruktions_grundfläche|floatformat:2 }} {{ building_metrics.konstruktions_grundfläche_unit }}</dd>
                <dt>Net floor area (NRF)</dt>
                <dd>{{ building_metrics.netto_raumfläche|floatformat:2 }} {{ building_metrics.netto_raumfläche_unit }}</dd>
                <dt>Gross volume (BRI)</dt>
                <dd>{{ building_metrics.brutto_rauminhalt|floatformat:2 }} {{ building_metrics.brutto_rauminhalt_unit }}</dd>
                <dt>BGF/BF ratio</dt>
                <dd>{{ building_metrics.bgf_bf_ratio|floatformat:2 }}</dd>
                <dt>BRI/BGF ratio</dt>
                <dd>{{ building_metrics.bri_bgf_ratio|floatformat:2 }}</dd>
            </dl>
            {% else %}
                <p class="model-detail__empty" role="status">Building metrics are not available.</p>
            {% endif %}
        </section>

        <section class="model-detail__card">
            <h3>Facade metrics</h3>
            {% if building_metrics %}
            <dl class="model-detail__properties">
                <dt>Gross facade area</dt>
                <dd>{{ building_metrics.fassadenflaeche|floatformat:2 }} {{ building_metrics.fassadenflaeche_unit }}</dd>
                <dt>Opening area</dt>
                <dd>{{ building_metrics.fassaden_oeffnungsflaeche|floatformat:2 }} {{ building_metrics.fassaden_oeffnungsflaeche_unit }}</dd>
                <dt>Opaque facade area</dt>
                <dd>{{ building_metrics.fassaden_opake_flaeche|floatformat:2 }} {{ building_metrics.fassaden_opake_flaeche_unit }}</dd>
                <dt>Window-to-wall ratio (WWR)</dt>
                <dd>{{ building_metrics.fenster_wand_verhaeltnis|ratio_percent|floatformat:2 }}%</dd>
            </dl>
            {% else %}
                <p class="model-detail__empty" role="status">Building metrics are not available.</p>
            {% endif %}
        </section>

        {% include "webapp/_energy_performance.jinja2" %}

        <section class="model-detail__card model-detail__card--wide" aria-labelledby="material-properties-heading">
            <h3 id="material-properties-heading">Material properties</h3>
            {% if materials %}
                <div class="model-detail__table-scroll">
                    <table class="model-detail__table">
                        <thead>
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Name</th>
                                <th scope="col">Global gross price</th>
                                <th scope="col">Local gross price</th>
                                <th scope="col">Local net price</th>
                                <th scope="col">Volume</th>
                                <th scope="col">Area</th>
                                <th scope="col">Length</th>
                                <th scope="col">Mass</th>
                                <th scope="col">PEnrT A1–A3</th>
                                <th scope="col">GWP A1–A3</th>
                                <th scope="col">AP A1–A3</th>
                                <th scope="col">PEnrT A1–A3 + B4</th>
                                <th scope="col">GWP A1–A3 + B4</th>
                                <th scope="col">AP A1–A3 + B4</th>
                                <th scope="col">PEnrT life cycle</th>
                                <th scope="col">GWP life cycle</th>
                                <th scope="col">AP life cycle</th>
                                <th scope="col">Recyclable mass</th>
                                <th scope="col">Waste mass</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for material in materials %}
                                <tr>
                                    <td>{{ material.id }}</td>
                                    <th scope="row">{{ material.name|default:"Unnamed material" }}</th>
                                    <td>{{ material.global_brutto_price|floatformat:2 }}</td>
                                    <td>{{ material.local_brutto_price|floatformat:2 }}</td>
                                    <td>{{ material.local_netto_price|floatformat:2 }}</td>
                                    <td>{{ material.volume|floatformat:2 }} m³</td>
                                    <td>{{ material.area|floatformat:2 }} m²</td>
                                    <td>{{ material.length|floatformat:2 }} m</td>
                                    <td>{{ material.mass|floatformat:2 }} kg</td>
                                    <td>{{ material.penrt_ml_a1_a3|floatformat:2 }}</td>
                                    <td>{{ material.gwp_ml_a1_a3|floatformat:2 }}</td>
                                    <td>{{ material.ap_ml_a1_a3|floatformat:2 }}</td>
                                    <td>{{ material.penrt_ml_a1_a3_b4|floatformat:2 }}</td>
                                    <td>{{ material.gwp_ml_a1_a3_b4|floatformat:2 }}</td>
                                    <td>{{ material.ap_ml_a1_a3_b4|floatformat:2 }}</td>
                                    <td>{{ material.penrt_ml_lz|floatformat:2 }}</td>
                                    <td>{{ material.gwp_ml_lz|floatformat:2 }}</td>
                                    <td>{{ material.ap_ml_lz|floatformat:2 }}</td>
                                    <td>{{ material.recyclable_mass|floatformat:2 }} kg</td>
                                    <td>{{ material.waste_mass|floatformat:2 }} kg</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="model-detail__empty" role="status">No materials are available for this model.</p>
            {% endif %}
        </section>

        {% include "webapp/_material_recycling_simulation.jinja2" %}

        {% for plot in html_plot %}
            <div class="model-detail__card model-detail__card--wide copy-parent">
                {{ plot|safe }}
            </div>
        {% endfor %}
    </div>
</div>
