{% load live_tags static %}
{% load theme_tags %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}djust start{% endblock %}</title>
    {# Project default theme = dark (like djust.org). djust-theming's anti-FOUC
       script falls back to 'system' when no choice is stored; seed 'dark' first
       so first-time visitors get dark regardless of OS preference. The theme
       panel still lets users switch to light/system (overwrites this value). #}
    <script>try { if (!localStorage.getItem('djust-theme-mode')) localStorage.setItem('djust-theme-mode', 'dark'); } catch (e) {}</script>
    {{ theme_head }}
    <link rel="stylesheet" href="{% static 'mycelium.css' %}">
    {% block extra_head %}{% endblock %}
</head>
<body>
{# dj-view wraps nav AND content so the presence chip in the nav can be
{#   reactively patched by the LiveView (it can only diff DOM inside its#}
{#   own root). Subclasses override {% block live_view %} to mount a#}
{#   different view; defaults to MyceliumView for the starter's single page. #}
<div dj-view="{% block live_view %}src.mycelium.views.CounterView{% endblock %}">
    <nav class="site-nav">
        <div class="nav-right">
            <span class="presence-chip">{{ online_count|default:1 }} online</span>
            {{ theme_panel }}
        </div>
    </nav>

    {# Banner is always rendered, hidden via class when count > 1. Toggling
       a class is a SetAttribute patch (in-place) — much more reliable than
       conditional render which fires InsertChild at a structural index
       the diff sometimes mis-computes (banner ends up at bottom of dj-view).
       href set via JS so it uses the current URL even after WS re-renders. #}
    <a href="/" target="_blank" rel="noopener"
       class="sync-banner{% if online_count and online_count > 1 %} sync-banner--hidden{% endif %}"
       onclick="window.open(location.href); return false;">
        <span class="sync-arrow">↗</span>
        Open this page in another window to see real-time sync.
    </a>

    <main>
        {% block content %}{% endblock %}
    <button dj-click="pp" data-pp="{{ pp }}">PEEPEE</button>

    </main>
</div>
</body>
</html>