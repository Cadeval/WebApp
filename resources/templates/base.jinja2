<div id="htmx-throbber">
    <div class="spinner"></div>
</div>
<main hx-boost="true" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="true">
    <div id="content-container">

        <!-- This is where the Debug Toolbar will be injected -->
        {# {% if debug %}#}
        {# {% endif %}#}
        <!-- Main Container -->
        {% block content %}{% endblock %}
    </div>
</main>
<!-- Footer Section -->
<!-- Copyrights Section -->
<!-- Main Container Ends -->
<footer class="footer">
    <div class="copyright">&copy; {% now 'Y' %} - <strong>Iuliia</strong></div>
</footer>

</body>
</html>
