        <section class="user-settings-island" aria-labelledby="capacity-heading">
            <h3 id="capacity-heading">Calculation capacity</h3>
            <dl class="settings-definition-list">
                <div><dt>Active calculations</dt><dd>{{ user.active_calculations }}</dd></div>
                <div><dt>Concurrent limit</dt><dd>{{ user.max_calculations }}</dd></div>
            </dl>
