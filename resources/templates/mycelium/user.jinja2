{% load static %}
{% load get_item %}

<div {% if fragment %}id="content-container"{% endif %} class="user-settings-page">
    <div class="user-settings-header">
        <p class="settings-eyebrow">Personal settings</p>
        <h2>{{ user.username }}</h2>
        <p>Manage reusable inputs and calculation preferences for your account.</p>
    </div>

    <div class="user-settings-grid">
        <section class="user-settings-island" aria-labelledby="account-heading">
            <h3 id="account-heading">Account</h3>
            <dl class="settings-definition-list">
                <div><dt>Username</dt><dd>{{ user.username }}</dd></div>
                <div><dt>Email</dt><dd>{{ user.email|default:"Not set" }}</dd></div>
                <div>
                    <dt>Groups</dt>
                    <dd>
                        {% for group in user_groups %}
                            {{ group.name }}{% if not forloop.last %}, {% endif %}
                        {% empty %}
                            None
                        {% endfor %}
                    </dd>
                </div>
            </dl>
        </section>

