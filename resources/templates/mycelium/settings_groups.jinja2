<section {% if fragment %}id="content-container"{% endif %} class="journey-page settings-page" aria-labelledby="groups-title">
    <div class="journey-section-heading"><span class="viewer-eyebrow">User settings · Administration</span><h1 id="groups-title">Groups</h1><p>Organize shared permissions for workspace users.</p><a href="/mycelium/settings?section=access" hx-get="/mycelium/settings?section=access" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="true">Back to access settings</a></div>
    {% include 'mycelium/_settings_notices.html' %}
    <div class="settings-table-viewport" tabindex="0" aria-label="Permission groups"><table class="settings-table"><thead><tr><th scope="col">Group</th><th scope="col">Permissions</th><th scope="col">Action</th></tr></thead><tbody>{% for group in groups %}<tr><th scope="row">{{ group.name }}</th><td>{{ group.permissions.count }}</td><td>{% if can_change and group.admin_editable %}<a href="/mycelium/settings/groups?group={{ group.pk }}" hx-get="/mycelium/settings/groups?group={{ group.pk }}" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="true">Edit</a>{% else %}<span class="settings-help">View only</span>{% endif %}</td></tr>{% empty %}<tr><td colspan="3">No groups to display.</td></tr>{% endfor %}</tbody></table></div>
    {% if group_form %}<section class="journey-card" aria-labelledby="group-editor-title"><h2 id="group-editor-title">{% if selected_group %}Edit {{ selected_group.name }}{% else %}Create group{% endif %}</h2><form method="post" action="/mycelium/settings/groups" hx-post="/mycelium/settings/groups" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="false" class="settings-form">{% csrf_token %}<input type="hidden" name="action" value="{% if selected_group %}update{% else %}create{% endif %}">{% if selected_group %}<input type="hidden" name="group_id" value="{{ selected_group.pk }}">{% endif %}{% include 'mycelium/_settings_form_fields.html' with form=group_form %}<div class="journey-actions"><button type="submit" hx-disable="this">{% if selected_group %}Save group{% else %}Create group{% endif %}</button>{% if selected_group %}<a href="/mycelium/settings/groups" hx-get="/mycelium/settings/groups" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="true">Cancel editing</a>{% endif %}</div></form></section>{% elif can_add %}<a class="journey-button" href="/mycelium/settings/groups" hx-get="/mycelium/settings/groups" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="true">Create group</a>{% endif %}
</section>
