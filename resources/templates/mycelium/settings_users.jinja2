<section {% if fragment %}id="content-container"{% endif %} class="journey-page settings-page" aria-labelledby="users-title">
    <div class="journey-section-heading"><span class="viewer-eyebrow">User settings · Administration</span><h1 id="users-title">Users</h1><p>Manage account access and calculation capacity.</p><a href="/mycelium/settings?section=access" hx-get="/mycelium/settings?section=access" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="true">Back to access settings</a></div>
    {% include 'mycelium/_settings_notices.html' %}
    <div class="settings-table-viewport" tabindex="0" aria-label="User accounts"><table class="settings-table"><thead><tr><th scope="col">User</th><th scope="col">Email</th><th scope="col">Access</th><th scope="col">Calculation limit</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead><tbody>
        {% for account in users %}<tr><th scope="row">{{ account.username }}{% if account.get_full_name %}<span class="settings-table-secondary">{{ account.get_full_name }}</span>{% endif %}</th><td>{{ account.email|default:'Not set' }}</td><td>{% if account.is_superuser %}Administrator{% elif account.is_staff %}Staff{% else %}Workspace user{% endif %}</td><td>{{ account.max_calculations }}</td><td>{% if account.is_active %}Active{% else %}Inactive{% endif %}</td><td>{% if can_change and account.admin_editable %}<div class="settings-row-actions"><a href="/mycelium/settings/users?user={{ account.pk }}" hx-get="/mycelium/settings/users?user={{ account.pk }}" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="true">Edit</a><form method="post" action="/mycelium/settings/users" hx-post="/mycelium/settings/users" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="false">{% csrf_token %}<input type="hidden" name="user_id" value="{{ account.pk }}"><input type="hidden" name="action" value="{% if account.is_active %}deactivate{% else %}activate{% endif %}"><button type="submit" hx-disable="this">{% if account.is_active %}Deactivate{% else %}Activate{% endif %}</button></form></div>{% else %}<span class="settings-help">View only</span>{% endif %}</td></tr>{% empty %}<tr><td colspan="6">No user accounts to display.</td></tr>{% endfor %}
    </tbody></table></div>
    {% if user_form %}<section class="journey-card" aria-labelledby="user-editor-title"><h2 id="user-editor-title">{% if selected_user %}Edit {{ selected_user.username }}{% else %}Create user{% endif %}</h2><form method="post" action="/mycelium/settings/users" hx-post="/mycelium/settings/users" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="false" class="settings-form">{% csrf_token %}<input type="hidden" name="action" value="{% if selected_user %}update{% else %}create{% endif %}">{% if selected_user %}<input type="hidden" name="user_id" value="{{ selected_user.pk }}">{% endif %}{% include 'mycelium/_settings_form_fields.html' with form=user_form %}<div class="journey-actions"><button type="submit" hx-disable="this">{% if selected_user %}Save user{% else %}Create user{% endif %}</button>{% if selected_user %}<a href="/mycelium/settings/users" hx-get="/mycelium/settings/users" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="true">Cancel editing</a>{% endif %}</div></form></section>{% elif can_add %}<a class="journey-button" href="/mycelium/settings/users" hx-get="/mycelium/settings/users" hx-target="#content-container" hx-swap="outerHTML" hx-push-url="true">Create user</a>{% endif %}
</section>
