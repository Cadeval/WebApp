{% load static %}

<div id="content-container">
    <section class="ifc-editor"
             data-ifc-editor
             data-worker-url="{% static 'js/plugins/example_plugin_worker.js' %}"
             data-wasm-url="{% static 'wasm/example_plugin.wasm' %}"
             tabindex="0"
             aria-labelledby="ifc-editor-title"
             aria-describedby="ifc-editor-notes">
        <div class="ifc-editor__header">
            <div>
                <h1 id="ifc-editor-title">IFC Editor</h1>
                <p>
                    Open a local <code>.ifc</code> file and edit its raw STEP attributes. The file is loaded
                    and parsed entirely inside an isolated, sandboxed WebAssembly worker: nothing is uploaded.
                </p>
            </div>
            <button type="button"
                    class="button ifc-editor__reload fa fa-refresh"
                    data-ifc-action="reload">
                Reload worker
            </button>
        </div>

        <p class="ifc-editor__status" data-ifc-field="status" role="status" aria-live="polite">
            Loading isolated IFC worker…
        </p>

        <div class="ifc-editor__layout">
            <div class="ifc-editor__intake">
                <label class="ifc-editor__file-label" for="ifc-editor-file-input">
                    <span class="fa fa-upload" aria-hidden="true"></span>
                    Choose a local .ifc file
                </label>
                <input type="file"
                       id="ifc-editor-file-input"
                       accept=".ifc"
                       data-ifc-file-input
                       aria-describedby="ifc-editor-notes">

                <div class="ifc-editor__dropzone"
                     data-ifc-dropzone
                     tabindex="0"
                     role="button"
                     aria-label="Drop a .ifc file here, or use the file picker above">
                    <span class="fa fa-file-o" aria-hidden="true"></span>
                    Drop a .ifc file here
                </div>

                <dl class="ifc-editor__summary">
                    <div>
                        <dt>Filename</dt>
                        <dd data-ifc-field="filename">—</dd>
                    </div>
                    <div>
                        <dt>Entities</dt>
                        <dd data-ifc-field="count">—</dd>
                    </div>
                    <div>
                        <dt>Worker generation</dt>
                        <dd data-ifc-field="generation">0</dd>
                    </div>
                </dl>

                <button type="button"
                        class="button-wide ifc-editor__download fa fa-download"
                        data-ifc-action="download"
                        disabled>
                    Download edited .ifc
                </button>
            </div>

            <div class="ifc-editor__browser">
                <h2 class="visually-hidden">Entities</h2>
                <div class="ifc-editor__pager">
                    <button type="button" class="button fa fa-chevron-left" data-ifc-action="prev-page" disabled>
                        Prev
                    </button>
                    <span data-ifc-field="page" aria-live="polite">No entities loaded</span>
                    <button type="button" class="button fa fa-chevron-right" data-ifc-action="next-page" disabled>
                        Next
                    </button>
                    <label class="ifc-editor__jump" for="ifc-editor-jump-input">
                        Jump to STEP id
                        <input type="number"
                               id="ifc-editor-jump-input"
                               min="0"
                               step="1"
                               data-ifc-jump-input
                               disabled>
                    </label>
                    <button type="button" class="button fa fa-search" data-ifc-action="jump" disabled>
                        Go
                    </button>
                </div>

                <div class="ifc-editor__table-scroll">
                    <table class="ifc-editor__entities" data-ifc-entity-list>
                        <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">STEP id</th>
                            <th scope="col">Type</th>
                        </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <div class="ifc-editor__inspector" data-ifc-inspector aria-live="polite">
                <h2>
                    Entity <span data-ifc-field="entity-id">—</span>
                    <span data-ifc-field="entity-type"></span>
                </h2>
                <p class="ifc-editor__placeholder" data-ifc-field="inspector-placeholder">
                    Select an entity from the list to inspect its attributes.
                </p>
                <div class="ifc-editor__table-scroll">
                    <table class="ifc-editor__attributes" data-ifc-attribute-list hidden>
                        <caption class="visually-hidden">Raw STEP attributes, in positional order</caption>
                        <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Kind</th>
                            <th scope="col">Value</th>
                        </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <p class="ifc-editor__validation"
                   data-ifc-field="validation"
                   role="alert"
                   aria-live="assertive"></p>
            </div>
        </div>

        <ul class="ifc-editor__notes" id="ifc-editor-notes">
            <li>
                <span class="fa fa-shield" aria-hidden="true"></span>
                Everything happens locally in your browser, inside a sandboxed worker; your file is never uploaded.
            </li>
            <li>Only scalar raw STEP attribute values can be viewed and edited here; read-only attributes are locked.</li>
            <li>Downloading always behaves like &ldquo;Save As&rdquo;: your original file on disk is left untouched.</li>
            <li>Geometry is not regenerated after an edit &mdash; only the underlying STEP attribute text changes.</li>
        </ul>
    </section>
</div>
