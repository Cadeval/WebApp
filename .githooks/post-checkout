#!/bin/sh
# Read-only source checks for the worktree Git has just checked out.
set -eu

checkout_root=$(git rev-parse --show-toplevel)
checker="$checkout_root/scripts/check_source.py"
if [ ! -f "$checker" ]; then
    printf '%s\n' 'Cadevil checkout checks failed: this revision has no scripts/check_source.py. The checkout is complete; use a supported revision or restore the missing checker.' >&2
    exit 1
fi

checkout_python=${CADEVIL_CHECK_PYTHON:-}
if [ -z "$checkout_python" ] && [ -x "$checkout_root/.venv/bin/python" ]; then
    checkout_python="$checkout_root/.venv/bin/python"
fi
if [ -z "$checkout_python" ]; then
    common_directory=$(git rev-parse --path-format=absolute --git-common-dir)
    if [ "$(basename "$common_directory")" = '.git' ] && [ -x "$(dirname "$common_directory")/.venv/bin/python" ]; then
        checkout_python="$(dirname "$common_directory")/.venv/bin/python"
    fi
fi
if [ -z "$checkout_python" ]; then
    checkout_python=$(command -v python3 || true)
fi
if [ -z "$checkout_python" ] || ! python_ready=$("$checkout_python" -I -B -c 'import sys; sys.exit(1) if sys.version_info < (3, 13) else None; print("cadevil-source-python-ready")' 2>/dev/null) || [ "$python_ready" != 'cadevil-source-python-ready' ]; then
    printf '%s\n' 'Cadevil checkout checks failed: Python 3.13 or newer is required. Use an existing .venv or set CADEVIL_CHECK_PYTHON to its interpreter; no dependencies were installed. The checkout is complete and your changes remain.' >&2
    exit 1
fi

if ! "$checkout_python" -I -B "$checker" --source "$checkout_root"; then
    printf '%s\n' 'Cadevil checkout checks failed. Resolve the reported source/package policy error, then retry the checkout or run scripts/check_source.py. The checkout is complete and your changes remain.' >&2
    exit 1
fi
printf '%s\n' 'Cadevil checkout checks passed.'
